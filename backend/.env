PORT=5000
FRONTEND_URL=http://localhost:5173

# MongoDB (Local या Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/bharat_seva
# Redis
REDIS_URL=redis://localhost:6379

# JWT Secrets
JWT_SECRET=super_secret_jwt_key_change_me
OTP_SECRET=super_secret_otp_key_change_me

# Email SMTP (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Bharat Seva AI <your_email@gmail.com>"

# Google Gemini API Key (AI Scheme Finder के लिए)
GEMINI_API_KEY=your_gemini_api_key